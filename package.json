{
  "name": "devops-portfolio",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/generate-rss.mjs",
    "build": "next build",
    "postbuild": "pagefind --site out",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "security:secrets": "bash scripts/check-no-secrets.sh",
    "security:audit": "node scripts/npm-audit-ci.mjs"
  },
  "dependencies": {
    "gray-matter": "4.0.3",
    "next": "16.2.10",
    "next-mdx-remote": "5.0.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.11",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "22.15.32",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "@vitejs/plugin-react": "4.5.2",
    "eslint": "9.30.1",
    "eslint-config-next": "16.2.10",
    "jsdom": "26.1.0",
    "pagefind": "1.5.2",
    "tailwindcss": "4.1.11",
    "typescript": "5.8.3",
    "vitest": "3.2.6"
  }
}
