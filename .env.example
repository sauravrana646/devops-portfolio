# Copy to .env.local (gitignored). Never commit real secrets.
# NEXT_PUBLIC_* values are embedded in the client bundle — public by design.

# Public site URL (no trailing slash), e.g. https://sauravrana646.github.io/devops-portfolio
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# GitHub project Pages path (leading slash, no trailing slash). Empty for user site / custom domain root.
NEXT_PUBLIC_BASE_PATH=

# Contact form id (public). When unset, submit opens a mailto draft.
# In GitHub Actions: Settings → Variables → NEXT_PUBLIC_FORMSPREE_ID (not a Secret).
# NEXT_PUBLIC_FORMSPREE_ID=

# Privacy-friendly analytics domain (public). Omit to disable the script.
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
